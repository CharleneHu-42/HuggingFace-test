From 4691896daa67dd2539cfb11da1227632519aa39d Mon Sep 17 00:00:00 2001
From: ywan171 <yi.a.wang@intel.com>
Date: Sun, 10 Jul 2022 23:29:03 -0700
Subject: [PATCH] fix the non-distributed training coredump with profile

Signed-off-by: ywan171 <yi.a.wang@intel.com>
---
 src/transformers/trainer.py | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/transformers/trainer.py b/src/transformers/trainer.py
index 6aa11e5..f74df31 100755
--- a/src/transformers/trainer.py
+++ b/src/transformers/trainer.py
@@ -33,7 +33,7 @@ from pathlib import Path
 from typing import TYPE_CHECKING, Any, Callable, Dict, List, Optional, Tuple, Union
 
 from tqdm.auto import tqdm
-
+import oneccl_bindings_for_pytorch
 
 # Integrations must be imported before ML frameworks:
 from .integrations import (  # isort: split
@@ -428,7 +428,7 @@ class Trainer:
         self.train_dataset = train_dataset
         self.eval_dataset = eval_dataset
         self.tokenizer = tokenizer
-        if int(os.environ["RANK"]) == 0:
+        if int(os.environ.get("RANK",0)) == 0:
             self.prof = torch.profiler.profile(
                 activities=[
                     torch.profiler.ProfilerActivity.CPU],
@@ -2353,7 +2353,7 @@ class Trainer:
         else:
             labels = None
         outputs = model(**inputs)
-        if int(os.environ["RANK"]) == 0:
+        if int(os.environ.get("RANK",0)) == 0:
             self.prof.step()
         # Save past state if it exists
         # TODO: this needs to be fixed and made cleaner later.
