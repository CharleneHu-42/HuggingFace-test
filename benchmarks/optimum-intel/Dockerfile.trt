FROM nvidia/cuda:12.2.0-devel-ubuntu22.04

RUN apt-get update && \
	apt-get -y install \
	python3.10 \
	python3-pip \
	openmpi-bin \
	libopenmpi-dev \
	git \
	wget \
	vim \
	bc \
	git-lfs \
	&& apt-get clean \
	&& rm -rf /var/lib/apt/lists/*

ARG TRT_VERSION=0.9.0

RUN pip3 install tensorrt_llm==${TRT_VERSION} -U --pre --extra-index-url https://pypi.nvidia.com

WORKDIR /workspace/data
RUN wget https://people.eecs.berkeley.edu/~hendrycks/data.tar && tar -xf data.tar && rm data.tar && mv data mmlu
COPY prompt.json /workspace/data/simple_bench/
WORKDIR /workspace
RUN git clone --branch v${TRT_VERSION} https://github.com/NVIDIA/TensorRT-LLM.git 
RUN yes | pip3 uninstall numpy && pip3 install numpy==1.26.4
COPY main.py mmlu.py benchmark_utils.py simple_bench.py run_benchmark.sh /workspace/benchmark/
