FROM nvidia/cuda:12.2.0-devel-ubuntu22.04

RUN apt-get update && \
	apt-get -y install \
	python3.10 \
	python3-pip \
	openmpi-bin \
	libopenmpi-dev \
	git \
	wget \
	vim \
	bc \
	git-lfs \
	&& apt-get clean \
	&& rm -rf /var/lib/apt/lists/*
   
RUN pip3 install tensorrt_llm -U --pre --extra-index-url https://pypi.nvidia.com

WORKDIR /workspace
COPY mmlu.py benchmark_utils.py run_benchmark.sh /workspace/benchmark/
RUN git clone https://github.com/NVIDIA/TensorRT-LLM.git
RUN wget https://people.eecs.berkeley.edu/~hendrycks/data.tar && tar -xf data.tar && rm data.tar
