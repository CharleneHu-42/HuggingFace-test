FROM intel/intel-extension-for-pytorch:2.3.10-xpu

RUN apt-get update && \
	apt-get -y install \
	git \
	wget \
	vim \
	bc \
	git-lfs \
	&& apt-get clean \
	&& rm -rf /var/lib/apt/lists/*

WORKDIR /opt
RUN git clone -b ipex-xpu https://github.com/faaany/optimum-intel.git
WORKDIR /opt/optimum-intel 
RUN pip install .