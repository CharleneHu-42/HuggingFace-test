ARG imageVersion
FROM ccr-registry.caas.intel.com/pytorch/pytorch-ipex-spr:${imageVersion}
LABEL maintainer="Hugging Face"

# Create virtual environment
RUN source /root/anaconda3/bin/activate pytorch

# Install torch-ccl
RUN python3 -m pip install oneccl_bind_pt==1.11.0 -f https://software.intel.com/ipex-whl-stable

# Install mpi
COPY l_mpi_oneapi_p_2021.6.0.602.sh .
RUN ./l_mpi_oneapi_p_2021.6.0.602.sh -a --eula accept -s && source /opt/intel/oneapi/setvars.sh

# Fetch transformer
RUN git clone https://github.com/huggingface/transformers && cd transformers/ && python3 -m pip install -e . && python3 -m pip install -r examples/pytorch/question-answering/requirements.txt && cd ../

# Install accelerate
RUN cd transformers/ && git clone https://github.com/huggingface/accelerate && cd accelerate && python3 -m pip install -e . && cd ../../


RUN python3 -m pip install --no-cache-dir --upgrade pip && python3 -m pip install --no-cache-dir git+https://github.com/huggingface/doc-builder ./transformers[dev]

# Torch needs to be installed before deepspeed
RUN python3 -m pip install --no-cache-dir ./transformers[deepspeed]

RUN python3 -m pip install --no-cache-dir torch-scatter -f https://data.pyg.org/whl/torch-1.12.0+cpu.html

# Prepare transformers
RUN cd transformers && pip install -r examples/pytorch/question-answering/requirements.txt && cd ../

# Test if the image could successfully build the doc. before publishing the image
RUN doc-builder build transformers transformers/docs/source/en --build_dir doc-build-dev --notebook_dir notebooks/transformers_doc --clean
RUN rm -rf doc-build-dev
