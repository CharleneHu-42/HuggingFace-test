FROM nvidia/cuda:12.1.0-devel-ubuntu22.04
ARG DEBIAN_FRONTEND=noninteractive

ARG PYTORCH='2.3.1'
ARG CUDA='cu121'
ARG PYTHON='3.10'
ARG REF=a9a756553f0e727703b2e8ee3e49a74e8d5ad350

RUN apt-get update && \
    apt-get -y install \
    python$PYTHON \
    python3-pip \
    python-is-python3 \
    git \
    cmake \
    ffmpeg \
    numactl \
    vim \
    wget \
    software-properties-common \
    git-lfs \
    libsndfile1-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --upgrade pip

WORKDIR /workspace
# Copied from https://github.com/huggingface/trl/blob/main/docker/trl-latest-gpu/Dockerfile
RUN pip install -U --no-cache-dir \
    librosa \
    "soundfile>=0.12.1" \
    scipy \
    transformers \
    accelerate \
    optimum \
    peft \
    pytest-excel \
    openpyxl \
    auto-gptq && \
    git clone https://github.com/TimDettmers/bitsandbytes && cd bitsandbytes && \
    cmake -B . -DCOMPUTE_BACKEND=cuda -S . && \
    cmake --build . && \
    pip install -e . && \ 
    pip freeze | grep bitsandbytes

RUN git clone https://github.com/huggingface/trl.git && cd trl && git checkout $REF && pip install -e .[test]


